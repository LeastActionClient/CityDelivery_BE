# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of EXTRA allowed browser origins (your deployed frontend URL(s)).
# https://citydeliveryservices.com, https://www.citydeliveryservices.com and local http://localhost:* origins are always allowed.
FRONTEND_URL=http://localhost:5173
# For Vercel previews or other deployments, add their origins here (comma-separated).
VERCEL_FRONTEND_URL=
# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx...)
TRUST_PROXY=0

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/city-delivery-services

# ---- SMTP (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=citydeliveryservicesofficial@gmail.com
SMTP_PASS=your-gmail-app-password
# Where new request / contact notifications are delivered
OWNER_EMAIL=citydeliveryservicesofficial@gmail.com
# Sender shown on outgoing mail, e.g. "City Delivery Services <no-reply@yourdomain.com>"
FROM_EMAIL=citydeliveryservicesofficial@gmail.com

# ---- Cloudinary (product image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=city-delivery-services/requests

# ---- Admin API (retry notifications, list requests, update status) ----
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
RIDER_SENSITIVE_API_KEY=

# ---- Franchise payments (Cashfree PG) ----
# Both values are required before online initial payment can be enabled.
# Get them from Cashfree Merchant Dashboard > Developers > API Keys.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# sandbox or production
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
# Optional if the webhook URL is configured directly in the Cashfree dashboard.
# Must be a public HTTPS URL, e.g. https://city-delivery-be.vercel.app/api/franchises/webhook
CASHFREE_WEBHOOK_URL=
# Used only when the optional x-admin-role header is absent on franchise admin APIs.
# owner (full access), franchise_manager (review/settings), support (read-only).
FRANCHISE_ADMIN_DEFAULT_ROLE=owner

# ---- Notification retry worker ----
NOTIFY_RETRY_INTERVAL_MINUTES=5
NOTIFY_MAX_ATTEMPTS=5
